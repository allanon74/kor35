# Copia in /etc/kor35/kiosk-station.env (l'installer lo fa). Non committare la PSK.

# Server. In bosco il DNS del mirror risolve www.kor35.it sulla LAN evento.
PILOT_BASE_URL=https://www.kor35.it

# Pagina iniziale: due pulsanti, poi QR di login.
KIOSK_START_PATH=/pilot/?screen=station&viewport=800x480

# 1 = lo script gestisce il WiFi. 0 = usi NetworkManager a mano.
KIOSK_WIFI_MANAGE=1

# Rete evento (Omada, modalità bosco). PSK vuota = usa solo un profilo già salvato con lo stesso nome.
KIOSK_WIFI_PRIMARY_SSID=kor35-larp
KIOSK_WIFI_PRIMARY_PSK=

# Se il bosco non c'è, prova questa rete. Viene aggiornata se scegli una rete a schermo.
KIOSK_WIFI_FALLBACK_SSID=
KIOSK_WIFI_FALLBACK_PSK=

# 1 = se entrambe falliscono, zenity elenca le reti visibili.
KIOSK_WIFI_PROMPT=1

# Interfaccia. Vuoto = nmcli sceglie.
# KIOSK_WIFI_IFACE=wlan0

# Pannello 7" 800x480. Rotate: normal | left | right | inverted
KIOSK_MODE=800x480
KIOSK_ROTATE=normal

# Disabilita il kiosk senza disinstallare: sudo touch /etc/kor35/NO_KIOSK
