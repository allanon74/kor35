[Unit]
Description=KOR35 kiosk stazione 800x480 (ingegneria / scientifica / comunicazioni)
After=display-manager.service graphical.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=__KIOSK_USER__
Group=__KIOSK_USER__
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/__KIOSK_USER__/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
EnvironmentFile=-/etc/kor35/kiosk-station.env
# Se la RAM finisce, il kernel chiude Chromium e systemd lo riapre.
OOMScoreAdjust=300
ExecStartPre=/bin/sleep 6
ExecStart=/usr/local/bin/kiosk-station.sh
Restart=on-failure
RestartSec=8

[Install]
WantedBy=graphical.target
