{
  "appId": "nativeapp.kor35.it",
  "appName": "KOR35",
  "webDir": "dist",
  "server": {
    "url": "https://www.kor35.it",
    "cleartext": true,
    "allowNavigation": [
      "www.kor35.it",
      "*.kor35.it",
      "kor35.it",
      "app.kor35.it",
      "www.k-o-r-35.it",
      "*.k-o-r-35.it",
      "k-o-r-35.it",
      "kor35.ddns.net",
      "www.arcanadomine.it",
      "arcanadomine.it",
      "*.arcanadomine.it",
      "10.42.0.1",
      "192.168.*.*",
      "10.*.*.*"
    ]
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#111827"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "hidden": false
    }
  }
}
