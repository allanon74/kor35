# Generato sul Pi da scripts/install_mirror_tunnel.sh → /etc/kor35/mirror-tunnel.env
# Non committare la chiave privata (resta in /etc/kor35/mirror-tunnel/).

MIRROR_TUNNEL_SSH_HOST=www.kor35.it
MIRROR_TUNNEL_SSH_PORT=22
MIRROR_TUNNEL_SSH_USER=kor35-tunnel
# Porta sul server prod, solo in ascolto su 127.0.0.1 (sshd -R).
MIRROR_TUNNEL_REMOTE_PORT=18443
# HTTPS del nginx Docker sul Pi.
MIRROR_TUNNEL_LOCAL_PORT=443
# SSH del Pi, sempre su 127.0.0.1 del server prod (deploy GitHub senza DDNS).
MIRROR_TUNNEL_SSH_REMOTE_PORT=18022
MIRROR_TUNNEL_SSH_LOCAL_PORT=22
