# Credenziali No-IP per il mirror Pi.
# Copiare in /etc/kor35/noip.env (chmod 600, root). Non committare il file reale.
#
# Stessi dati del DUC Windows, oppure una DDNS key creata su noip.com
# (Dynamic DNS → il tuo hostname → DDNS key). Lo username No-IP è un'email.
#
# Dopo aver compilato il file, spegni il DUC sul PC Windows: due client
# sullo stesso hostname si sovrascrivono a vicenda.
#
#   sudo install -m 600 config/mirror/noip.env.example /etc/kor35/noip.env
#   sudo nano /etc/kor35/noip.env
#   sudo systemctl start kor35-mirror-noip.service

NOIP_USERNAME="CHANGE_ME"
NOIP_PASSWORD="CHANGE_ME"
NOIP_HOSTNAME="kor35.ddns.net"

# 1 = prova ad aprire sul router (UPnP) TCP 80, 443 e 22→10022.
# Se il router ha UPnP spento, i forward vanno fatti a mano.
NOIP_UPNP="1"

# Mappe UPnP: porta_locale:porta_esterna (solo TCP).
NOIP_UPNP_TCP_MAPS="80:80 443:443 22:10022"

# Secondi tra una conferma e l'altra se l'IP pubblico non cambia.
# No-IP va aggiornato quando l'IP cambia; una conferma al giorno tiene vivo il check.
NOIP_REFRESH_SEC="86400"
