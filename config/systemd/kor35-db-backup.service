[Unit]
Description=KOR35 - Backup giornaliero PostgreSQL (dump)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot

# Path monorepo produzione (DigitalOcean)
WorkingDirectory=/srv/kor35

# Directory backup (permessi 700 consigliati)
Environment=KOR35_DB_BACKUP_DIR=/var/backups/kor35/db
# Conserva solo gli ultimi N dump giornalieri (+ checksum); 0 = usa RETENTION_DAYS
Environment=KOR35_DB_BACKUP_KEEP=10
Environment=KOR35_DB_BACKUP_RETENTION_DAYS=0
Environment=KOR35_DB_BACKUP_ENABLE_MONTHLY_ARCHIVE=1
Environment=KOR35_DB_BACKUP_MONTHLY_ARCHIVE_DIR=/var/backups/kor35/db/monthly

ExecStart=/srv/kor35/scripts/backup_db_daily.sh --env prod
