[Unit]
Description=KOR35 Mirror - Sync media (push best-effort + pull)
After=network.target docker.service kor35-mirror-stack.service

[Service]
Type=oneshot
User=pi
Group=pi

# Adatta se il path repo sul Pi e' diverso
WorkingDirectory=/home/pi/kor35-replica

# Richiede .env.sync-media configurato con credenziali/host/path master.
# Push può fallire (permessi su master); il pull deve comunque girare.
# Preferisci lo script repo; fallback inline se manca (pre-merge / reset hard).
ExecStart=/bin/bash -lc 'if [ -x ./scripts/mirror_media_sync.sh ]; then ./scripts/mirror_media_sync.sh; else make sync-media-push || echo "WARN: sync-media-push failed, continuing with pull" >&2; make sync-media; fi'

NoNewPrivileges=true
PrivateTmp=true
