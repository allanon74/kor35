[Unit]
Description=KOR35 Mirror - Scheduler sync media (orario)

[Timer]
# Ogni ora: i path media arrivano col sync DB (~2 min) ma i file solo via rsync.
# Senza pull frequente (rubriche, post, wiki) il mirror mostra immagini rotte.
OnCalendar=*-*-* *:15:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
