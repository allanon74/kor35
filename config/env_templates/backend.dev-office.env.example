# Template dev-office (Docker WSL) → copia in backend/.env.dev-office
#
# Con ENVIRONMENT=raspberry_docker (compose) viene aggiunto "*" a ALLOWED_HOSTS.

DEBUG=True

SECRET_KEY=CHANGE_ME_DEV_OFFICE_SECRET_KEY

ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=kor35_dev
DB_USER=kor35_dev
DB_PASSWORD=kor35_dev

# Replica → master (obbligatorio per DB allineato a produzione).
EDGE_SYNC_URL=https://www.kor35.it/api/sync/edge/
EDGE_SYNC_TOKEN=
EDGE_NODE_NAME=dev-office
EDGE_SYNC_VERBOSE_ERRORS=True
# Dopo deploy master: make sync-db ENV=dev-office  (stato in .runtime-state/edge_sync_dev-office.json)

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

SMTP_EMAIL=dev@example.local
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Mailhog locale (porta 1025) non usa TLS. Per Gmail: smtp.gmail.com + EMAIL_USE_TLS=True.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

EXTRA_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
EXTRA_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081

# Arcana SSO v2 (OAuth2 + PKCE)
ARCANA_SSO_ENABLED=False
ARCANA_SSO_BASE_URL=https://DOMINIO-AD/wp-json/ad-sso/v2
ARCANA_SSO_CLIENT_ID=
ARCANA_SSO_CLIENT_SECRET=
ARCANA_SSO_REDIRECT_URI=http://localhost:8081/api/auth/arcana/callback/
ARCANA_SSO_FRONTEND_LOGIN_PATH=/login

# Libreria minigioco QR (Openverse OAuth opzionale; fallback Wikimedia Commons).
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Chiamate vocali (WebRTC). TURN locale (coturn) attivo su overlay compose.
# TURN_RELAY_ENABLED è forzato a true dal compose (dev-office/home/mirror).
# Credenziali di default: kor35turn / kor35turnlocal (cambiale sul Pi).
# CHIAMATE_VOCALI_ENABLED=True
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_USERNAME=kor35turn
# TURN_CREDENTIAL=kor35turnlocal
# TURN_PORT=3478
# Override manuale (disabilita auto-host): TURN_URLS=turn:10.42.0.1:3478?transport=udp
